# Copy to .env and fill in real values. Never commit .env.
# local | test | staging | production
APP_ENV=local
# URL-encode special characters in the password (e.g. @ -> %40)
DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>/<database>?driver=ODBC+Driver+17+for+SQL+Server
# Separate, disposable database used by pytest (tables are dropped/recreated)
TEST_DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>/<database>_test?driver=ODBC+Driver+17+for+SQL+Server
# Long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=<generate-a-long-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200
# Private evidence file storage (local filesystem adapter)
STORAGE_DIR=storage
MAX_UPLOAD_MB=20
# FarmFuture API – read-only pulls by the FarmFuture Water Balance Engine adapter. The token is a secret.
FARMFUTURE_API_BASE_URL=https://api.farmfuture.io
FARMFUTURE_API_TOKEN=

# Automatic daily pulls (sources with config.schedule_daily_at). Prefer running
# `python -m app.services.integration.scheduler` every 15 minutes; enable the in-process runner only when the API runs
# as a single process.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=300
# Account recorded on scheduled runs (needs integration.manage); default: the first active super administrator
# MRV_SCHEDULER_EMAIL=
