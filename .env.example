# Copy to .env and fill in real values. Never commit .env.
# local | test | staging | production
APP_ENV=local
# URL-encode special characters in the password (e.g. @ -> %40)
DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>/<database>?driver=ODBC+Driver+17+for+SQL+Server
# Separate, disposable database used by pytest (tables are dropped/recreated)
TEST_DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>/<database>_test?driver=ODBC+Driver+17+for+SQL+Server
# Long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=<generate-a-long-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200
# Private evidence file storage (local filesystem adapter)
STORAGE_DIR=storage
MAX_UPLOAD_MB=20
